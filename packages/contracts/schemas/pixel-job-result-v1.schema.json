{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel-hq.local/schemas/pixel-job-result-v1.schema.json",
  "title": "Pixel Job Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "event_name", "schema_version", "completed_at", "environment", "trace_id", "span_id", "job_id", "execution_id", "state", "outcome_code", "summary", "provenance"],
  "properties": {
    "result_id": { "$ref": "#/$defs/identifier" },
    "event_name": { "const": "pixel.job.result.v1" },
    "schema_version": { "const": "1.0.0" },
    "completed_at": { "type": "string", "format": "date-time", "pattern": "^(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$" },
    "environment": { "$ref": "#/$defs/environment" },
    "trace_id": { "$ref": "#/$defs/trace_id" },
    "span_id": { "$ref": "#/$defs/span_id" },
    "job_id": { "$ref": "#/$defs/identifier" },
    "execution_id": { "$ref": "#/$defs/identifier" },
    "state": { "enum": ["COMPLETED", "FAILED"] },
    "outcome_code": { "enum": ["SYSTEM_STATUS_AVAILABLE", "CAPABILITY_DENIED", "AUTHORIZATION_UNAVAILABLE", "WORKER_UNAVAILABLE", "WORKER_RESULT_INVALID"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
    "provenance": { "oneOf": [{ "$ref": "#/$defs/worker_provenance" }, { "$ref": "#/$defs/model_provenance" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "COMPLETED" } } },
      "then": {
        "properties": {
          "outcome_code": { "const": "SYSTEM_STATUS_AVAILABLE" }
        }
      },
      "else": { "properties": { "outcome_code": { "enum": ["CAPABILITY_DENIED", "AUTHORIZATION_UNAVAILABLE", "WORKER_UNAVAILABLE", "WORKER_RESULT_INVALID"] } } }
    },
    {
      "if": { "properties": { "outcome_code": { "enum": ["CAPABILITY_DENIED", "AUTHORIZATION_UNAVAILABLE"] } } },
      "then": { "properties": { "provenance": { "$ref": "#/$defs/denied_worker_provenance" } } },
      "else": { "properties": { "provenance": { "oneOf": [{ "$ref": "#/$defs/executed_worker_provenance" }, { "$ref": "#/$defs/model_provenance" }] } } }
    },
    {
      "if": {
        "properties": {
          "state": { "const": "COMPLETED" },
          "provenance": { "required": ["model_gateway_contract"] }
        },
        "required": ["state", "provenance"]
      },
      "then": {
        "properties": {
          "provenance": { "$ref": "#/$defs/completed_model_provenance" }
        }
      }
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "trace_id": { "type": "string", "pattern": "^(?!0{32}$)[0-9a-f]{32}$" },
    "span_id": { "type": "string", "pattern": "^(?!0{16}$)[0-9a-f]{16}$" },
    "environment": { "enum": ["dev", "simulation", "shadow", "canary", "production"] },
    "worker_provenance": { "type": "object", "additionalProperties": false, "required": ["relay_contract", "worker_contract", "worker_source"], "properties": { "relay_contract": { "const": "pixel.relay.v1" }, "worker_contract": { "oneOf": [{ "const": "pixel.system-status-worker.v1" }, { "type": "null" }] }, "worker_source": { "oneOf": [{ "enum": ["simulator", "live"] }, { "type": "null" }] } } },
    "executed_worker_provenance": { "type": "object", "additionalProperties": false, "required": ["relay_contract", "worker_contract", "worker_source"], "properties": { "relay_contract": { "const": "pixel.relay.v1" }, "worker_contract": { "const": "pixel.system-status-worker.v1" }, "worker_source": { "enum": ["simulator", "live"] } } },
    "denied_worker_provenance": { "type": "object", "additionalProperties": false, "required": ["relay_contract", "worker_contract", "worker_source"], "properties": { "relay_contract": { "const": "pixel.relay.v1" }, "worker_contract": { "type": "null" }, "worker_source": { "type": "null" } } },
    "model_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["relay_contract", "model_gateway_contract", "model_invocation_id", "model_runtime_id", "model_id", "model_source"],
      "properties": {
        "relay_contract": { "const": "pixel.relay.v1" },
        "model_gateway_contract": { "const": "pixel.model-gateway.v1" },
        "model_invocation_id": { "$ref": "#/$defs/identifier" },
        "model_runtime_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "model_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "model_source": { "oneOf": [{ "const": "simulator" }, { "type": "null" }] }
      },
      "oneOf": [
        { "properties": { "model_runtime_id": { "$ref": "#/$defs/identifier" }, "model_id": { "$ref": "#/$defs/identifier" }, "model_source": { "const": "simulator" } } },
        { "properties": { "model_runtime_id": { "type": "null" }, "model_id": { "type": "null" }, "model_source": { "type": "null" } } }
      ]
    },
    "completed_model_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["relay_contract", "model_gateway_contract", "model_invocation_id", "model_runtime_id", "model_id", "model_source"],
      "properties": {
        "relay_contract": { "const": "pixel.relay.v1" },
        "model_gateway_contract": { "const": "pixel.model-gateway.v1" },
        "model_invocation_id": { "$ref": "#/$defs/identifier" },
        "model_runtime_id": { "$ref": "#/$defs/identifier" },
        "model_id": { "$ref": "#/$defs/identifier" },
        "model_source": { "const": "simulator" }
      }
    }
  }
}
