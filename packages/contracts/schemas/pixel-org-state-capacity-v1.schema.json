{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel-hq.local/schemas/pixel-org-state-capacity-v1.schema.json",
  "title": "Pixel Capacity State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capacity_id",
    "event_name",
    "schema_version",
    "revision",
    "updated_at",
    "resource_ref",
    "capacity",
    "provenance"
  ],
  "properties": {
    "capacity_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 160
    },
    "event_name": {
      "const": "pixel.org-state.capacity.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "string",
      "pattern": "^(?:(?:\\d{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|02-(?:0[1-9]|1\\d|2[0-8])))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "resource_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "capacity": {
      "enum": [
        "AVAILABLE",
        "LIGHT",
        "NORMAL",
        "HIGH",
        "SATURATED",
        "UNAVAILABLE"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "org_state_contract"
      ],
      "properties": {
        "org_state_contract": {
          "const": "pixel.organizational-state.v1"
        }
      }
    }
  }
}
