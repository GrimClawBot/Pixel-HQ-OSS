{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel-hq.local/schemas/pixel-model-provider-result-v1.schema.json",
  "title": "Pixel Model Provider Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_result_id", "schema_version", "invocation_id", "provider_contract", "runtime_id", "model_id", "source", "status", "output_text", "output_token_units"],
  "properties": {
    "provider_result_id": { "$ref": "#/$defs/identifier" },
    "schema_version": { "const": "1.0.0" },
    "invocation_id": { "$ref": "#/$defs/identifier" },
    "provider_contract": { "const": "pixel.model-runtime.adapter.v1" },
    "runtime_id": { "$ref": "#/$defs/identifier" },
    "model_id": { "$ref": "#/$defs/identifier" },
    "source": { "const": "simulator" },
    "status": { "const": "OUTPUT_AVAILABLE" },
    "output_text": { "type": "string", "minLength": 1, "maxLength": 512 },
    "output_token_units": { "type": "integer", "minimum": 1 }
  },
  "$defs": { "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" } }
}
