{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel-hq.local/schemas/pixel-memory-intake-intent-v1.schema.json",
  "title": "Pixel Memory Intake Intent v1",
  "description": "Caller-supplied, non-authoritative Memory content.",
  "$comment": "This schema provides structural and lexical validation only. The Pixel runtime validator is authoritative for normalization-derived empty, length, and duplicate tag rejection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_name", "schema_version", "content"],
  "properties": {
    "event_name": { "const": "pixel.memory.intake-intent.v1" },
    "schema_version": { "const": "1.0.0" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "Normalized by the runtime using NFKC, lowercase, Unicode tokenization, and ASCII-hyphen joining."
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tag" }
        }
      }
    }
  }
}
